{
  "name": "student-planner-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "build": "npm run prisma:generate",
    "verify:integration": "node scripts/integration-check.js",
    "verify:academic": "node scripts/academic-integration-check.js",
    "test": "node --test tests/*.test.js",
    "verify:onboarding": "node scripts/onboarding-integration-check.js",
    "verify:password-recovery": "node scripts/password-recovery-integration-check.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
